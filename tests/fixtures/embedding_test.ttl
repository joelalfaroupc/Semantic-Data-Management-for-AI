@prefix bda: <https://example.org/bda/barcelona-tourism/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://example.org/bda/barcelona-tourism/district/sants-montjuic> rdfs:label "Sants-Montjuic" .

<https://example.org/bda/barcelona-tourism/neighborhood/el-poble-sec> a bda:Neighborhood ;
    rdfs:label "el Poble Sec" ;
    bda:inDistrict <https://example.org/bda/barcelona-tourism/district/sants-montjuic> ;
    bda:hasTourismPressure <https://example.org/bda/barcelona-tourism/pressure/high> ;
    bda:hasAirbnbZone <https://example.org/bda/barcelona-tourism/airbnb-zone/el-poble-sec> ;
    bda:incomeEur 18000 ;
    bda:hutCount 25 ;
    bda:licensedBeds 125 .

<https://example.org/bda/barcelona-tourism/airbnb-zone/el-poble-sec> a bda:AirbnbZone ;
    rdfs:label "Airbnb zone for el Poble Sec" ;
    bda:describesNeighborhood <https://example.org/bda/barcelona-tourism/neighborhood/el-poble-sec> ;
    bda:listingCount 100 ;
    bda:avgPrice 200 ;
    bda:avgRating 4.6 .

<https://example.org/bda/barcelona-tourism/neighborhood/hostafrancs> a bda:Neighborhood ;
    rdfs:label "Hostafrancs" ;
    bda:inDistrict <https://example.org/bda/barcelona-tourism/district/sants-montjuic> ;
    bda:hasTourismPressure <https://example.org/bda/barcelona-tourism/pressure/medium> ;
    bda:hasAirbnbZone <https://example.org/bda/barcelona-tourism/airbnb-zone/hostafrancs> ;
    bda:hutCount 5 ;
    bda:licensedBeds 15 .

<https://example.org/bda/barcelona-tourism/airbnb-zone/hostafrancs> a bda:AirbnbZone ;
    rdfs:label "Airbnb zone for Hostafrancs" ;
    bda:describesNeighborhood <https://example.org/bda/barcelona-tourism/neighborhood/hostafrancs> ;
    bda:listingCount 20 ;
    bda:avgPrice 120 ;
    bda:avgRating 4.2 .
